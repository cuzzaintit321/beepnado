# Run the worker on a different network from the sites it monitors.
WORKER_REGION=offsite
WORKER_INTERVAL=300
WORKER_WATCH_URLS=https://beepnado.com/,https://rebootsyndicate.com/,https://jasonpauledwards.com/

# Optional independent email for outages and recoveries. Use SMTP reachable when yeet is offline.
WORKER_ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# Optional BeepNado dashboard sync. Set the same random token on the main server.
BEEPNADO_URL=
WORKER_TOKEN=
