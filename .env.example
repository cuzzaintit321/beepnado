# Public app is a separate HTTPS host behind the existing Caddy reverse proxy.
SITE_URL=https://app.beepnado.com
SESSION_SECURE=true
REGISTRATION_ENABLED=false
MAX_USERS=50
# Enable registration only AFTER verifying SMTP delivery and password reset email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
# Set to the current IP of the jason-portfolio container on portfolio_default.
# Do not trust proxy IP headers from other sources.
TRUSTED_PROXY_IP=
WORKER_TOKEN=
# Paid billing remains disabled until configured and tested with Stripe webhooks.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
